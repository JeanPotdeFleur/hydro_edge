[Unit]
Description=Pin all cores to the performance governor
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
# GATE A1 was measured under performance. The default ondemand governor raises
# frequency in response to load, and charges the transition latency to the
# start of each 32 MB copy on a thread that sleeps 447 ms between them, which
# is the class of jitter the timing campaign exists to remove. The setting does
# not survive a reboot on its own, so a power cut at Agassiz would silently
# return the station to an untested configuration.
#
# $$c rather than $c: systemd expands $VAR in ExecStart and would substitute
# an empty string.
ExecStart=/bin/sh -c 'for c in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo performance > "$$c"; done'
ExecStart=/bin/sh -c 'echo "governor now: $$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor)"'

[Install]
WantedBy=multi-user.target
