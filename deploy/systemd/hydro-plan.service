[Unit]
Description=Hydro station daily plan resolution
Documentation=https://github.com/JeanPotdeFleur/hydro_edge
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=bakerlab
Group=bakerlab
EnvironmentFile=/etc/default/hydro-edge
ExecStart=/home/bakerlab/hydro_edge/scripts/fetch_plan.sh

# Publish again once the plan is resolved. Without this the page shows
# the plan as it stood at 08:00, before the day's plan had been read at
# 09:50, so a researcher editing at 09:30 never sees the edit confirmed:
# the page keeps announcing the previous schedule until the next morning.
# The morning image is unchanged and costs nothing to republish, git
# storing no new blob for an identical file.
ExecStart=/home/bakerlab/hydro_edge/scripts/push_status.sh

SyslogIdentifier=hydro-plan
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
